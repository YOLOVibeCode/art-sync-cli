# ArtSync lab (do not commit the real .env)
#
# Copy to ../.env and fill the Azure password after ./scripts/lab-azure.sh

ARTSYNC_RESOURCE_GROUP=rg-artsync
ARTSYNC_LOCATION=westus2
ARTSYNC_SQL_ADMIN=artsyncadmin
ARTSYNC_SQL_PASSWORD=

# Filled by lab-azure.sh
ARTSYNC_AZURE_SERVER=
ARTSYNC_AZURE_DB=MARS

# Local Docker SQL (on-prem stand-in)
ARTSYNC_LOCAL_SERVER=localhost,1433
ARTSYNC_LOCAL_DB=MARS
ARTSYNC_LOCAL_USER=sa
ARTSYNC_LOCAL_PASSWORD=ArtSync_Test@2026

# Filled by lab-azure.sh (quoted; values contain spaces/semicolons)
# ARTSYNC_SRC_CS="Server=….database.windows.net,1433;Database=MARS;User ID=artsyncadmin;Password=…;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60"
# ARTSYNC_TGT_CS="Server=localhost,1433;Database=MARS;User ID=sa;Password=ArtSync_Test@2026;TrustServerCertificate=True;Connection Timeout=30"
